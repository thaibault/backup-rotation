{
  "name": "backup-rotation",
  "version": "2.0.0",
  "description": "This script allows you to create a local or remote backup rotation for your files.",
  "keywords": [
    "automatic",
    "backup",
    "rotation",
    "replication",
    "synchronization"
  ],
  "homepage": "https://tsickert.com/backup-rotation",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/backup-rotation.git"
  },
  "main": "backup-rotation.sh",
  "bin": "backup-rotation.sh",
  "files": [
    "backup-rotation.timer",
    "backup-rotation.service"
  ],
  "scripts": {
    "build": "echo nothing to build.",
    "clear": "[ ! -e apiDocumentation ] || rm --recursive apiDocumentation",
    "document": "mkdir --parents apiDocumentation/backup-rotation/latest && bash ./node_modules/.bin/bashlink-document backup-rotation 1>apiDocumentation/backup-rotation/latest/index.html",
    "document:show": "bash ./node_modules/.bin/bashlink-document backup-rotation",
    "document:show:error": "bash ./node_modules/.bin/bashlink-document backup-rotation 1>/dev/null",
    "lint": "shellcheck -x *.sh",
    "lint:given": "shellcheck -x",
    "test": "bash ./node_modules/.bin/bashlink-doctest --verbose ../../backup-rotation",
    "update:documentation": "web-documentation"
  },
  "dependencies": {
    "bashlink": "2.0.1"
  },
  "devDependencies": {
    "shellcheck": "^4.1.0",
    "web-documentation": "^1.0.77"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ]
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
